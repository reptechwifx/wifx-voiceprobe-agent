# Local Marc-Home builder only. Never distributed or run on client Windows.
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && apt-get install -y --no-install-recommends \
    make gcc-mingw-w64-x86-64-posix g++-mingw-w64-x86-64-posix \
    swig python3 ca-certificates unzip file \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
